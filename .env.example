# .env.example - configure e copie para .env
# Configuração de Email (Gmail)
# Gere uma "App Password" do Google em: https://myaccount.google.com/apppasswords
# Copie a senha para EMAIL_HOST_PASSWORD
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=seu_app_password_aqui
EMAIL_USE_DEVELOPMENT=False
# Força uso de SMTP mesmo com DEBUG=True (útil para testes locais com App Password)
EMAIL_FORCE_SMTP=False

# Segurança e Ambiente (Django)
# Defina DEBUG=False em produção para ativar todas as proteções (cookies seguros, HSTS, cabeçalhos de segurança, etc.)
DEBUG=True
# Altere para uma chave secreta longa e aleatória em produção
DJANGO_SECRET_KEY=django-insecure-bar-escola-dev-key-change-in-production
# Lista de domínios permitidos em produção separados por vírgula (ex: barescola.com,12.34.56.78)
# ALLOWED_HOSTS=barescola.com,www.barescola.com
